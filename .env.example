# Ace-Arb Bot Configuration
# For Render.com deployment, set these as Environment Variables in the dashboard

# ===========================================
# REQUIRED: Trading Mode
# ===========================================
DRY_RUN=false
STARTING_CAPITAL=1000

# ===========================================
# REQUIRED: Authentication (Choose ONE mode)
# ===========================================

# Option 1: EOA Mode (your own wallet)
# PRIVATE_KEY=0x...your_private_key...
# SIGNATURE_TYPE=0

# Option 2: Proxy Mode (Polymarket email login) - RECOMMENDED
SIGNATURE_TYPE=1
FUNDER_ADDRESS=0x...your_proxy_wallet_address...
API_KEY=your_api_key
API_SECRET=your_api_secret
API_PASSPHRASE=your_api_passphrase

# ===========================================
# OPTIONAL: Multi-Wallet (for parallel execution)
# ===========================================
# ADDITIONAL_API_CREDS='[{"api_key":"...","api_secret":"...","api_passphrase":"...","funder_address":"0x..."}]'

# ===========================================
# OPTIONAL: Notifications
# ===========================================
# BIG_ARB_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Per Grok Round 21: Volume farming webhook for airdrop tracking
# Reports: total volume, cost, volume:cost ratio, projected airdrop equity
# VOLUME_FARMING_WEBHOOK_URL=https://discord.com/api/webhooks/...
# VOLUME_FARMING_WEBHOOK_INTERVAL=10  # Send webhook every N trash trades

# ===========================================
# OPTIONAL: Advanced Settings
# ===========================================
LOG_LEVEL=INFO
# BURST_PARALLEL_DEPTH_RATIO=2.0
# POLYGON_RPC_URL=https://polygon-rpc.com
